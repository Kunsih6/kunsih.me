---
import NavControl from '@/components/common/NavControl.astro'
import { languages, locales } from '@/i18n/ui'
import { getLang, localizedPath, useTranslations } from '@/i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
---

<nav aria-label={t('lang.label')} class="lang t-label" data-lang-switch data-lang={lang}>
  {locales.map((l, i) => (
    <>
      {i > 0 && <span aria-hidden="true">/</span>}
      <NavControl
        href={localizedPath(l)}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'page' : undefined}
        title={languages[l]}
      >
        {l.toUpperCase()}
        <span class="sr-only"> — {languages[l]}</span>
      </NavControl>
    </>
  ))}
</nav>

<script>
  const switches = [...document.querySelectorAll<HTMLElement>('[data-lang-switch]')]

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch] a[hreflang]')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', link.hreflang)
      } catch {}
    })
  }

  /*
   * A browser that translates the page (Chrome, Safari, Firefox) changes the `lang` of <html>, and
   * Chrome also adds a `translated-ltr` or `translated-rtl` class. The page then shows neither of
   * the site's versions, and the browser would translate the one the switch opens too, so the
   * switch hides until the translation is turned off.
   */
  const root = document.documentElement
  function hideWhileTranslated() {
    const marked = root.classList.contains('translated-ltr') || root.classList.contains('translated-rtl')
    for (const nav of switches) {
      nav.hidden = marked || root.lang !== nav.dataset.lang
    }
  }
  hideWhileTranslated()
  new MutationObserver(hideWhileTranslated).observe(root, { attributes: true, attributeFilter: ['lang', 'class'] })
</script>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-muted);
  }

  .lang[hidden] {
    display: none;
  }

  .lang a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
</style>
