---
import type { HTMLAttributes } from 'astro/types'
import NavControl from '@/components/common/NavControl.astro'
import { getLang, useTranslations } from '@/i18n/utils'

type Props = HTMLAttributes<'nav'>

const { class: className, ...rest } = Astro.props
const t = useTranslations(getLang(Astro.currentLocale))

const links = [
  { href: '#experience', label: t('nav.experience') },
  { href: '#stack', label: t('nav.stack') },
  { href: '#contact', label: t('nav.contact') },
]
---

<nav aria-label={t('nav.label')} class:list={['links', className]} data-spy {...rest}>
  {links.map((link) => (
    <NavControl href={link.href} class="link">
      {link.label}
    </NavControl>
  ))}
</nav>

<script>
  // State, not motion: it also runs with reduced motion.
  const spied = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy] a[href^="#"]')]
  if (spied.length) {
    const sections = spied.map((link) => document.getElementById(link.hash.slice(1)))
    let frame = 0
    const paint = () => {
      frame = 0
      const scrolls = document.documentElement.scrollHeight - innerHeight > 8
      const current = sections.findLastIndex(
        (section) => section && section.getBoundingClientRect().top <= innerHeight * 0.45,
      )
      spied.forEach((link, i) => {
        if (scrolls && i === current) {
          link.setAttribute('aria-current', 'location')
        } else {
          link.removeAttribute('aria-current')
        }
      })
    }
    const schedule = () => {
      frame ||= requestAnimationFrame(paint)
    }
    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', schedule)
    paint()
  }
</script>

<style>
  .links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .link {
    padding: 0 var(--nav-link-pad, 12px);
  }

  .link[aria-current='location'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
</style>
