---
import type { HTMLAttributes } from 'astro/types'
import { getLang, useTranslations } from '@/i18n/utils'

/*
 * Availability, with a dot that sends out a radar ping. It drops the work mode, then hides,
 * as the screen narrows. The header passes `class` to place it in the bar.
 */
type Props = HTMLAttributes<'p'>

const { class: className, ...rest } = Astro.props
const t = useTranslations(getLang(Astro.currentLocale))
---

<p class:list={['status', 't-label', className]} {...rest}>
  <span class="dot" aria-hidden="true"></span>
  <span>{t('status.available')}</span>
  <span class="status-more t-muted">{t('status.mode')}</span>
</p>

<style>
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--signal);
    white-space: nowrap;
  }

  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--signal);
  }

  /* Available: the dot sends out a radar ping, with a pause between pings. */
  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--signal);
      opacity: 0;
      pointer-events: none;
      animation: status-ping 2.4s cubic-bezier(0.16, 1, 0.3, 1) 1.2s infinite both;
    }
  }

  @keyframes status-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }

    62%,
    100% {
      transform: scale(3.6);
      opacity: 0;
    }
  }

  @media (max-width: 1180px) {
    .status-more {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .status {
      display: none;
    }
  }
</style>
