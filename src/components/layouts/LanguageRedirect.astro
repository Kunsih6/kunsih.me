---
import { locales } from '@/i18n/ui'
import { localizedPath } from '@/i18n/utils'

/* Never redirect by browser language: crawlers and new visitors get the page at its URL. */
const homes = Object.fromEntries(locales.map((l) => [l, localizedPath(l)]))
---

<script is:inline define:vars={{ homes }}>
  try {
    const saved = localStorage.getItem('lang')
    if (saved !== null && Object.hasOwn(homes, saved) && homes[saved] !== location.pathname) {
      location.replace(homes[saved] + location.search + location.hash)
    }
  } catch {}
</script>
