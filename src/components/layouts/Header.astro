---
import Wordmark from '@/components/common/Wordmark.astro'
import LanguageSwitch from '@/components/layouts/header/LanguageSwitch.astro'
import SectionNav from '@/components/layouts/header/SectionNav.astro'
import StatusBadge from '@/components/layouts/header/StatusBadge.astro'
import ThemeToggle from '@/components/layouts/header/ThemeToggle.astro'
import { site } from '@/config/site'
import { getLang, localizedPath, useTranslations } from '@/i18n/utils'

/*
 * The sticky bar. It lays out the brand and the pieces in ./header/, each of which brings its
 * own markup, script and styles, and moves the section links to a row of their own on narrow
 * screens.
 */
interface Props {
  minimal?: boolean
}

const { minimal = false } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const home = localizedPath(lang)
---

<header class="header">
  <div class="bar">
    <a href={minimal ? home : '#top'} class="brand">
      <Wordmark />
      <span class="sr-only">
        {site.brand} — {t('a11y.home')}
      </span>
    </a>

    {!minimal && <SectionNav class="bar-links" />}

    <div class="controls">
      <StatusBadge class="bar-status" />
      <LanguageSwitch />
      <ThemeToggle />
    </div>
  </div>

  <!-- Reading progress, scaled by src/scripts/motion.ts. -->
  <div class="progress" aria-hidden="true" data-progress></div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 24px;
    min-height: 56px;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Sizes the wordmark, which is set in em. */
    font-size: 15px;
    color: var(--ink);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 4px 12px;
  }

  .bar-status {
    margin-right: 4px;
  }

  .progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--cobalt);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media print {
    .progress {
      display: none;
    }
  }

  @media (max-width: 920px) {
    .bar-links {
      order: 3;
      /* Full bleed: span the gutters on both sides. */
      flex-basis: calc(100% + 2 * var(--gutter));
      justify-content: space-between;
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 16px;
      border-top: 1px solid var(--line);
      overflow-x: auto;
      --nav-link-pad: 6px;
    }
  }
</style>
