---
import type { HTMLAttributes } from 'astro/types'

/*
 * Neither variant takes `type`: <Tag> needs props valid for both elements, and a link's
 * `type` (a MIME type) clashes with a button's.
 */
type Props =
  | (Omit<HTMLAttributes<'a'>, 'type'> & { href: string })
  | (Omit<HTMLAttributes<'button'>, 'href' | 'type'> & { href?: undefined })

const { class: className, ...rest } = Astro.props
const Tag = rest.href === undefined ? 'button' : 'a'
---

<Tag
  class:list={['nav-control', 't-label', className]}
  {...(Tag === 'button' ? { type: 'button' as const } : {})}
  {...rest}
>
  <slot />
</Tag>

<style>
  .nav-control {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 140ms linear;
  }

  button.nav-control {
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  /* A current item (`aria-current`) keeps the color its parent gives it. */
  @media (hover: hover) {
    .nav-control:not([aria-current]):hover {
      color: var(--ink);
    }
  }
</style>
