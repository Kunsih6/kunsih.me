---
/*
 * Each letter's overlapping strokes are merged into one path, so an outline shows only its
 * silhouette. Decorative: give the surrounding element the accessible name.
 */
import Letters from '@/assets/brand/kunsih.svg'

interface Props {
  outline?: boolean
  class?: string
}

const { outline = false, class: className } = Astro.props

// The viewBox is in font units (1000 per em), so the wordmark is sized in em like text.
const width = `${Letters.width / 1000}em`
---

<Letters
  class={className}
  width={width}
  aria-hidden="true"
  focusable="false"
  fill={outline ? 'none' : 'currentColor'}
  stroke={outline ? 'currentColor' : undefined}
  stroke-width={outline ? 1 : undefined}
  overflow={outline ? 'visible' : undefined}
/>
