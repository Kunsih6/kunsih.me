---
import ButtonLink from '@/components/common/ButtonLink.astro'
import Wordmark from '@/components/common/Wordmark.astro'
import SectionLayout from '@/components/layouts/SectionLayout.astro'
import { site } from '@/config/site'
import { cv } from '@/data/cv'
import { getLang } from '@/i18n/utils'

const { hero } = cv[getLang(Astro.currentLocale)]
---

<SectionLayout class="hero" spacing="none" divider aria-labelledby="hero-title" data-hero>
  <div class="inner">
    <div class="meta t-code t-muted">
      <span>N° 001 // KS-CV // {hero.updated}</span>
      <span>
        {site.location.coordinates} // {site.location.city}, {site.location.countryCode}
      </span>
    </div>

    <div class="word" role="img" aria-label={site.brand}>
      <!-- Each layer moves on its own: scroll drift, pointer lean, then the intro. -->
      <div class="ghost" data-ghost>
        <div class="ghost-x" data-ghost-x>
          <Wordmark outline class="ghost-letters" />
        </div>
      </div>
      <Wordmark class="solid" />
      <span class="corner tl" aria-hidden="true"></span>
      <span class="corner tr" aria-hidden="true"></span>
      <span class="corner br" aria-hidden="true"></span>
      <span class="corner bl" aria-hidden="true"></span>
    </div>

    <div class="bottom">
      <div class="copy">
        <h1 id="hero-title" class="headline">
          {hero.headline}
        </h1>
        <p class="t-body-lg t-muted intro">{hero.intro}</p>
      </div>
      <div class="actions">
        <ButtonLink href="#contact">{hero.primaryCta}</ButtonLink>
        <ButtonLink href={site.social.linkedin} variant="ghost" external>
          {hero.secondaryCta}
        </ButtonLink>
      </div>
    </div>
  </div>
</SectionLayout>

<style>
  /* Fills the first screen; the vertical padding is on .inner, which grows into it. */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--nav-h));
    min-height: calc(100dvh - var(--nav-h));
    overflow: hidden;
  }

  .inner {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(24px, 4vh, 48px);
    padding-block: clamp(24px, 4vh, 48px) clamp(32px, 6vh, 72px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    text-transform: uppercase;
  }

  /* Poster word with an outlined echo as its shadow and HUD corner brackets. */
  .word {
    /* Shadow offset of the outlined echo: a little lower and to the right. */
    --echo-x: 0.04375em;
    --echo-y: 0.15em;

    position: relative;
    display: grid;
    width: fit-content;
    max-width: 100%;
    /* Room between the letters (and their echo) and the corner brackets. */
    padding: 0.07em calc(0.07em + var(--echo-x)) calc(0.07em + var(--echo-y)) 0.07em;
    color: var(--ink);
    /* Sizes the wordmark, which is set in em. */
    font-size: clamp(48px, 17vw, 280px);
  }

  .ghost,
  .word :global(.solid) {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .word :global(svg) {
    max-width: 100%;
    height: auto;
  }

  /* `translate` composes with the scroll drift that motion.ts sets as `transform`. */
  .ghost {
    translate: var(--echo-x) var(--echo-y);
  }

  .ghost-x {
    transition: transform 160ms linear;
  }

  /* Painted over the transformed echo, so the filled letters hide its lines. */
  .word :global(.solid) {
    position: relative;
  }

  .corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid var(--line-strong);
  }

  .tl {
    top: -12px;
    left: -12px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .tr {
    top: -12px;
    right: -12px;
    border-top-width: 2px;
    border-right-width: 2px;
  }

  .br {
    bottom: -12px;
    right: -12px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  .bl {
    bottom: -12px;
    left: -12px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
  }

  .copy {
    flex: 1 1 420px;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(21px, 2.2vw, 32px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .intro {
    max-width: 54ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /*
   * Intro: the name and the actions come in first, then the poster finishes its gesture.
   * Pure CSS on load, so nothing waits for JavaScript and nothing can stay hidden.
   */
  @media (prefers-reduced-motion: no-preference) {
    .headline,
    .intro,
    .actions {
      animation: hero-lift 420ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .headline {
      animation-delay: 60ms;
    }

    .intro {
      animation-delay: 130ms;
    }

    .actions {
      animation-delay: 200ms;
    }

    /* Each letter rises out of the wordmark's own box, which clips it. */
    .word :global(.solid path) {
      animation: hero-rise 820ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .word :global(.solid path:nth-child(1)) {
      animation-delay: 140ms;
    }

    .word :global(.solid path:nth-child(2)) {
      animation-delay: 205ms;
    }

    .word :global(.solid path:nth-child(3)) {
      animation-delay: 270ms;
    }

    .word :global(.solid path:nth-child(4)) {
      animation-delay: 335ms;
    }

    .word :global(.solid path:nth-child(5)) {
      animation-delay: 400ms;
    }

    .word :global(.solid path:nth-child(6)) {
      animation-delay: 465ms;
    }

    /* The echo steps out from behind the letters. */
    .word :global(.ghost-letters) {
      animation: hero-echo 480ms steps(6, end) 900ms both;
    }

    .corner {
      animation: hero-blink 240ms steps(3, end) both;
    }

    .tl {
      animation-delay: 1000ms;
    }

    .tr {
      animation-delay: 1070ms;
    }

    .br {
      animation-delay: 1140ms;
    }

    .bl {
      animation-delay: 1210ms;
    }

    /* The meta lines type in; no fill afterwards, so the clip goes away. */
    .meta > span {
      animation: hero-type 520ms steps(16, end) 1000ms backwards;
    }

    .meta > span + span {
      animation-delay: 1140ms;
    }
  }

  @keyframes hero-lift {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(108%);
    }
  }

  @keyframes hero-echo {
    from {
      opacity: 0;
      transform: translate(calc(-1 * var(--echo-x)), calc(-1 * var(--echo-y)));
    }
  }

  @keyframes hero-blink {
    from {
      opacity: 0;
    }
  }

  /* Both ends are `inset()`: `none` cannot be interpolated, so the typing would jump. */
  @keyframes hero-type {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }
</style>
