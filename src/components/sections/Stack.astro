---
import SectionHeader from '@/components/common/SectionHeader.astro'
import SectionLayout from '@/components/layouts/SectionLayout.astro'
import { cv } from '@/data/cv'
import { getLang } from '@/i18n/utils'

const { stack } = cv[getLang(Astro.currentLocale)]

// Continues the experience section, so it has no top padding.
---

<SectionLayout id="stack" spacing="bottom" aria-labelledby="stack-title">
  <SectionHeader index={4} eyebrow={stack.eyebrow} title={stack.title} titleId="stack-title" />

  <div class="groups">
    {stack.groups.map((group) => (
      <div class="group">
        <h3 class="t-label t-muted">{group.title}</h3>
        <ul role="list" class="items">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</SectionLayout>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 40px 0;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px 24px 0 0;
    border-top: 1px solid var(--line);
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
