---
import SectionHeader from '@/components/common/SectionHeader.astro'
import SectionLayout from '@/components/layouts/SectionLayout.astro'
import { cv } from '@/data/cv'
import { getLang } from '@/i18n/utils'

const { profile } = cv[getLang(Astro.currentLocale)]

// One span per word, so the statement can light up word by word while it scrolls (see the styles).
const words = [
  ...profile.statement
    .trim()
    .split(/\s+/)
    .map((text) => ({ text, accent: false })),
  ...profile.statementAccent
    .trim()
    .split(/\s+/)
    .map((text) => ({ text, accent: true })),
]
---

<SectionLayout id="profile" divider aria-labelledby="profile-title">
  <SectionHeader index={2} eyebrow={profile.eyebrow}>
    <h2
      id="profile-title"
      class="t-title statement"
      aria-label={`${profile.statement} ${profile.statementAccent}`}
      style={`--steps: ${words.length + 3}`}
    >
      {words.map((word, i) => (
        <>
          {i > 0 && ' '}
          <span class:list={{ 't-accent': word.accent }} style={`--i: ${i}`} aria-hidden="true">
            {word.text}
          </span>
        </>
      ))}
    </h2>
  </SectionHeader>

  <dl class="facts">
    {profile.facts.map((fact, i) => (
      <div class="fact" data-reveal="up" data-reveal-delay={i * 80}>
        <dt class="t-label t-muted">{fact.label}</dt>
        <dd class="t-body-lg">{fact.value}</dd>
      </div>
    ))}
  </dl>
</SectionLayout>

<style>
  .statement {
    max-width: 28em;
  }

  /*
   * Over the scroll from the statement's top meeting the viewport bottom to its bottom being 10vh
   * above it, each word in turn brightens over one of `--steps` equal parts: the last one is lit
   * about 80% of the way through. Decorative, so browsers without support show it fully lit.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .statement {
        view-timeline: --statement block;
      }

      .statement > span {
        --scroll: calc(100% + 10vh);

        animation: statement-word auto linear both;
        animation-timeline: --statement;
        animation-range-start: entry calc(var(--scroll) * var(--i) / var(--steps));
        animation-range-end: entry calc(var(--scroll) * (var(--i) + 1) / var(--steps));
      }
    }
  }

  @keyframes statement-word {
    from {
      opacity: 0.2;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 28px 0;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 24px 0 0;
    border-top: 1px solid var(--line);
  }
</style>
